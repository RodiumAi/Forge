{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.rodiumai.io/contracts/forge-design/codelab.schema.json",
  "title": "Forge codelab",
  "description": "codelab.json of a `codelab` project: metadata, ordered steps (each one an extended Markdown file under steps/) and downloadable files under files/. Version 1. Rules JSON Schema cannot express (unique step and download ids, unique step files) are enforced by the API and web validators.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "level", "durationMinutes", "steps"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 2000 },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "durationMinutes": { "type": "integer", "minimum": 0, "maximum": 6000 },
    "prerequisites": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "learn": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "maxLength": 2000, "pattern": "^https://" }
      }
    },
    "repoUrl": { "type": "string", "maxLength": 2000, "pattern": "^https://" },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designSystem", "tokens"],
      "properties": {
        "designSystem": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tokens": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/step" }
    },
    "downloads": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/download" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "minutes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 200 },
        "file": {
          "description": "steps/<nn>-<slug>.md",
          "type": "string",
          "pattern": "^steps/[0-9]{2,3}-[a-z0-9]+(-[a-z0-9]+)*\\.md$"
        },
        "minutes": { "type": "integer", "minimum": 0, "maximum": 600 }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "path": {
          "description": "A file or folder under files/. `zip` packs it at publish time.",
          "type": "string",
          "maxLength": 300,
          "pattern": "^files/(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
        },
        "zip": { "type": "boolean" }
      }
    }
  }
}
