      "w": 740,
      "h": 2,
      "z": 2,
      "shape": "rect",
      "fill": "--fg"
    },
    {
      "id": "s5-caption",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 900,
      "w": 740,
      "h": 80,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Une plume et une feuille : le geste de l'écriture résiste aux écrans."
        }
      ],
      "style": {
        "font": "body",
        "size": 22,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4,
        "italic": true
      }
    }
  ]
}
