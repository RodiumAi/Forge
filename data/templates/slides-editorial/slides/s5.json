{
  "id": "s5",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s5-image",
      "type": "image",
      "x": 140,
      "y": 100,
      "w": 740,
      "h": 760,
      "z": 1,
      "src": "public/images/pen.webp",
      "alt": "Plume posée sur une feuille dans la lumière du soir",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "tehzeebkazmi",
        "url": "https://pixabay.com/photos/fountain-pen-write-calligraphy-6200263/"
      }
    },
    {
      "id": "s5-bar",
      "type": "shape",
      "x": 1000,
      "y": 180,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s5-kicker",
      "type": "text",
      "role": "label",
      "x": 1000,
      "y": 206,
      "w": 780,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Portrait"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s5-heading",
      "type": "text",
      "role": "heading",
      "x": 1000,
      "y": 256,
      "w": 780,
      "h": 210,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Écrire pour mieux lire"
        }
      ],
      "style": {
        "font": "display",
        "size": 60,
        "weight": 500,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s5-body",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 490,
      "w": 780,
      "h": 180,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "De plus en plus de lecteurs tiennent un carnet de lecture, à la main, pour garder trace de ce qu'ils lisent."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.5
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s5-list",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 690,
      "w": 780,
      "h": 250,
      "z": 3,
      "content": [
        {
          "type": "bullet-list",
          "items": [
            {
              "text": "28 % tiennent un carnet"
            },
            {
              "text": "Surtout entre 25 et 40 ans"
            },
            {
              "text": "Souvent par des citations recopiées"
            }
          ]
        }
      ],
      "style": {
        "font": "body",
        "size": 28,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.55
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s5-page",
      "type": "text",
      "role": "caption",
      "x": 1660,
      "y": 1000,
      "w": 120,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "05"
        }
      ],
      "style": {
        "font": "body",
        "size": 20,
        "weight": 400,
        "color": "--muted",
        "align": "right",
        "lineHeight": 1.4
      }
    },
    {
      "id": "s5-caprule",
      "type": "shape",
      "x": 140,
