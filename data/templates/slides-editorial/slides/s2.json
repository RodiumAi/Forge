{
  "id": "s2",
  "background": {
    "type": "image",
    "src": "public/images/newspaper.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.9,
    "credit": {
      "source": "pixabay",
      "author": "Pezibear",
      "url": "https://pixabay.com/photos/newspaper-daily-newspaper-newsprint-671630/"
    }
  },
  "elements": [
    {
      "id": "s2-number",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 120,
      "w": 600,
      "h": 380,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "I"
        }
      ],
      "style": {
        "font": "display",
        "size": 320,
        "weight": 500,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      },
      "opacity": 0.9
    },
    {
      "id": "s2-bar",
      "type": "shape",
      "x": 140,
      "y": 510,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s2-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 550,
      "w": 1500,
      "h": 200,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Ce qui a changé"
        }
      ],
      "style": {
        "font": "display",
        "size": 88,
        "weight": 500,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s2-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 770,
      "w": 1400,
      "h": 100,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Le temps de lecture se fragmente, mais ne disparaît pas."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    }
  ]
}
