{
  "id": "s5",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s5-image",
      "type": "image",
      "x": 1040,
      "y": 0,
      "w": 880,
      "h": 1080,
      "z": 1,
      "src": "public/images/code.webp",
      "alt": "Écran affichant du code coloré",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "Pexels",
        "url": "https://pixabay.com/photos/code-coding-computer-data-1839406/"
      }
    },
    {
      "id": "s5-bar",
      "type": "shape",
      "x": 140,
      "y": 180,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s5-kicker",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 206,
      "w": 780,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Compilateur"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s5-heading",
      "type": "text",
      "role": "heading",
      "x": 140,
      "y": 256,
      "w": 780,
      "h": 210,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Un compilateur qui lit votre intention"
        }
      ],
      "style": {
        "font": "display",
        "size": 60,
        "weight": 700,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s5-body",
      "type": "text",
      "role": "body",
      "x": 140,
      "y": 490,
      "w": 780,
      "h": 180,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Nebula analyse chaque route et décide où elle s'exécute selon ses dépendances et son cache."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.5
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s5-list",
      "type": "text",
      "role": "body",
      "x": 140,
      "y": 690,
      "w": 780,
      "h": 250,
      "z": 3,
      "content": [
        {
          "type": "bullet-list",
          "items": [
            {
              "text": "Routes statiques prérendues"
            },
            {
              "text": "Routes avec données en edge"
            },
            {
              "text": "Mutations sur le serveur d'origine"
            }
          ]
        }
      ],
      "style": {
        "font": "body",
        "size": 28,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.55
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s5-page",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 1000,
      "w": 120,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "05"
        }
      ],
      "style": {
        "font": "body",
        "size": 20,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    }
  ]
}
