{
  "id": "s6",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s6-bar",
      "type": "shape",
      "x": 140,
      "y": 100,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s6-kicker",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 126,
      "w": 1200,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Valeurs"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s6-heading",
      "type": "text",
      "role": "heading",
      "x": 140,
      "y": 176,
      "w": 1640,
      "h": 140,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Quatre valeurs, quatre preuves"
        }
      ],
      "style": {
        "font": "display",
        "size": 64,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s6-body",
      "type": "text",
      "role": "body",
      "x": 140,
      "y": 360,
      "w": 1060,
      "h": 560,
      "z": 3,
      "content": [
        {
          "type": "bullet-list",
          "items": [
            {
              "text": "Hospitalité : chaque habitué est accueilli par son prénom"
            },
            {
              "text": "Transparence : prix payé au producteur imprimé sur le sachet"
            },
            {
              "text": "Artisanat : torréfaction par petits lots de 12 kg"
            },
            {
              "text": "Patience : jamais vendu moins de 8 jours après torréfaction"
            }
          ]
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.55
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s6-panel",
      "type": "shape",
      "x": 1300,
      "y": 360,
      "w": 480,
      "h": 560,
      "z": 1,
      "shape": "rect",
      "fill": "--surface",
      "stroke": "--border",
      "strokeWidth": 1,
      "radius": 28
    },
    {
      "id": "s6-icon",
      "type": "icon",
      "x": 1360,
      "y": 420,
      "w": 72,
      "h": 72,
      "z": 3,
      "icon": "hand-heart",
      "color": "--accent",
      "strokeWidth": 1.75
    },
    {
      "id": "s6-callout",
      "type": "text",
      "role": "body",
      "x": 1360,
      "y": 530,
      "w": 360,
      "h": 340,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Une valeur sans preuve n'est qu'un slogan : chaque valeur a donc son geste."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.45
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s6-footer",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 1000,
      "w": 1100,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Maison Okra · Plateforme de marque"
        }
