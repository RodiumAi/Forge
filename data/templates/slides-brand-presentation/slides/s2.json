{
  "id": "s2",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s2-image",
      "type": "image",
      "x": 100,
      "y": 160,
      "w": 760,
      "h": 760,
      "z": 1,
      "src": "public/images/cafe.webp",
      "alt": "Intérieur d'un café, tables et chaises en bois",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "tianya1223",
        "url": "https://pixabay.com/photos/cafe-interior-furniture-tables-5635015/"
      },
      "radius": 380
    },
    {
      "id": "s2-bar",
      "type": "shape",
      "x": 1000,
      "y": 180,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s2-kicker",
      "type": "text",
      "role": "label",
      "x": 1000,
      "y": 206,
      "w": 780,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Notre histoire"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s2-heading",
      "type": "text",
      "role": "heading",
      "x": 1000,
      "y": 256,
      "w": 780,
      "h": 210,
      "z": 3,
