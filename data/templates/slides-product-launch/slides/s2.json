{
  "id": "s2",
  "background": {
    "type": "image",
    "src": "public/images/gift.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.7,
    "credit": {
      "source": "pixabay",
      "author": "image4you",
      "url": "https://pixabay.com/photos/gift-present-wood-package-gift-box-1420830/"
    }
  },
  "elements": [
    {
      "id": "s2-number",
      "type": "text",
      "role": "label",
      "x": 460,
      "y": 200,
      "w": 1000,
      "h": 260,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "01"
        }
      ],
      "style": {
        "font": "display",
        "size": 220,
        "weight": 700,
        "color": "--accent",
        "align": "center",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s2-bar",
      "type": "shape",
      "x": 900,
      "y": 500,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s2-title",
      "type": "text",
      "role": "title",
      "x": 160,
      "y": 540,
      "w": 1600,
      "h": 200,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Le problème"
        }
      ],
      "style": {
        "font": "display",
        "size": 88,
        "weight": 700,
        "color": "--fg",
        "align": "center",
        "lineHeight": 1.1,
        "uppercase": true
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s2-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 310,
      "y": 760,
      "w": 1300,
      "h": 100,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Les enceintes connectées se voient plus qu'elles ne s'entendent."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--muted",
        "align": "center",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    }
  ]
}
