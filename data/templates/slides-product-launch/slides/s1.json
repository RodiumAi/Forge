{
  "id": "s1",
  "background": {
    "type": "image",
    "src": "public/images/spot.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.55,
    "credit": {
      "source": "pixabay",
      "author": "JanBrzezinski",
      "url": "https://pixabay.com/photos/performers-dancing-silhouette-dance-5644247/"
    }
  },
  "elements": [
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 900,
      "y": 290,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 160,
      "y": 326,
      "w": 1600,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Keynote · 3 novembre 2026"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "center",
        "lineHeight": 1.4,
        "letterSpacing": 4,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 160,
      "y": 390,
      "w": 1600,
      "h": 310,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Voici Halo"
        }
      ],
      "style": {
        "font": "display",
        "size": 160,
        "weight": 700,
        "color": "--fg",
        "align": "center",
        "lineHeight": 1.05,
        "letterSpacing": 0,
        "uppercase": true
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 310,
      "y": 720,
      "w": 1300,
      "h": 130,
      "z": 3,
      "opacity": 0.88,
      "content": [
        {
          "type": "paragraph",
          "text": "L'enceinte qui remplit la pièce et s'efface du regard."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "center",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 160,
      "y": 930,
      "w": 1600,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Sonore · Paris, La Seine Musicale"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "center",
        "lineHeight": 1.4
      }
    }
  ]
}
