{
  "id": "s4",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s4-image",
      "type": "image",
      "x": 80,
      "y": 80,
      "w": 800,
      "h": 920,
      "z": 1,
      "src": "public/images/studio.webp",
      "alt": "Boîte sombre éclairée par un faisceau de lumière",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "StockSnap",
        "url": "https://pixabay.com/photos/dark-night-light-shadow-m-corner-2588513/"
      },
      "radius": 48
    },
    {
      "id": "s4-bar",
      "type": "shape",
      "x": 1000,
      "y": 180,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s4-kicker",
      "type": "text",
      "role": "label",
      "x": 1000,
      "y": 206,
      "w": 780,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Le design"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s4-heading",
      "type": "text",
      "role": "heading",
      "x": 1000,
      "y": 256,
      "w": 780,
      "h": 210,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Un objet, pas un gadget"
        }
      ],
      "style": {
        "font": "display",
        "size": 56,
        "weight": 700,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1,
        "uppercase": true,
        "letterSpacing": 1
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s4-body",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 490,
      "w": 780,
      "h": 180,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Aluminium recyclé, tissu acoustique tissé en France, un seul bouton. Halo s'accorde avec la pièce."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.5
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s4-list",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 690,
      "w": 780,
      "h": 250,
      "z": 3,
      "content": [
        {
          "type": "bullet-list",
          "items": [
            {
              "text": "Trois coloris : sable, ardoise, cuivre"
            },
            {
              "text": "1,2 kg, 18 cm de haut"
            },
            {
              "text": "Aucune application obligatoire"
            }
          ]
        }
      ],
      "style": {
        "font": "body",
        "size": 28,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.55
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s4-page",
      "type": "text",
      "role": "caption",
      "x": 1660,
      "y": 1000,
      "w": 120,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "04"
        }
      ],
      "style": {
        "font": "body",
        "size": 20,
        "weight": 400,
        "color": "--muted",
        "align": "right",
        "lineHeight": 1.4
      }
    }
  ]
}
