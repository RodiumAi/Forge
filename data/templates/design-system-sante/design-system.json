      "sm": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 30,
          "unit": "px"
        }
      },
      "full": {
        "$value": {
          "value": 9999,
          "unit": "px"
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "sm": {
        "$value": {
          "color": "#0000000f",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "md": {
        "$value": {
          "color": "#0000001a",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": -2,
            "unit": "px"
          }
        },
        "$extensions": {
          "forge": {
            "style": "soft"
          }
        }
