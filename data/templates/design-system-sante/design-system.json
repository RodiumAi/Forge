      "lg": {
        "$value": {
          "color": "#00000029",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 32,
            "unit": "px"
          },
          "spread": {
            "value": -8,
            "unit": "px"
          }
        }
      }
