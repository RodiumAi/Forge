    "motion": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 400,
          "unit": "ms"
        },
        "$extensions": {
          "forge": {
            "style": "calm"
          }
        }
      },
      "slow": {
        "$value": {
          "value": 700,
          "unit": "ms"
        }
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    },
    "icon": {
      "library": {
        "$value": "lucide",
        "$description": "Icônes rondes et douces, toujours avec un libellé."
      },
      "style": {
        "$value": "outline",
        "$extensions": {
          "forge": {
            "guidance": {
              "summary": "Icônes rondes et douces, toujours avec un libellé.",
              "do": [
                "Libellé sous chaque icône d'action",
                "Grandes zones de toucher (44 px)"
              ],
              "dont": [
                "Icônes anatomiques réalistes",
                "Seringues ou sang"
              ]
            }
          }
        }
      },
