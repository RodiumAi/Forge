{
  "id": "s12",
  "background": {
    "type": "image",
    "src": "public/images/studio.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.86,
    "credit": {
      "source": "pixabay",
      "author": "TRDStudios",
      "url": "https://pixabay.com/photos/studio-design-coffee-x-pen-apple-4800295/"
    }
  },
  "elements": [
    {
      "id": "s12-bar",
      "type": "shape",
      "x": 140,
      "y": 260,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s12-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 300,
      "w": 1640,
      "h": 230,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Parlons de votre projet"
        }
      ],
      "style": {
        "font": "display",
        "size": 112,
        "weight": 600,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": -2
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s12-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 550,
      "w": 1400,
      "h": 110,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Premier rendez-vous offert, sur place ou en visio."
        }
      ],
      "style": {
        "font": "body",
        "size": 38,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s12-icon1",
      "type": "icon",
      "x": 140,
      "y": 730,
      "w": 48,
      "h": 48,
      "z": 3,
      "icon": "mail",
      "color": "--accent",
      "strokeWidth": 1.75,
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 400,
        "order": 0
      }
    },
    {
      "id": "s12-contact1",
      "type": "text",
      "role": "body",
      "x": 216,
      "y": 730,
      "w": 1200,
      "h": 52,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "bonjour@camilleroy.example"
        }
