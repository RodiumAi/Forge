  "logo": {
    "src": "public/brand/logo.svg",
    "minSizePx": 40,
    "clearSpace": "Deux fois l'épaisseur du trait du O",
    "usage": [
      "Noir sur papier",
      "Blanc sur le rose",
      "Peut être recadré à fond perdu en très grand",
      "Avoid: Le centrer timidement en petit",
      "Avoid: Ombre portée douce",
      "Avoid: Couleurs pastel"
    ]
  },
  "voice": {
    "summary": "Affirmé et joueur. On montre plus qu'on n'explique.",
    "do": [
      "Titres courts et percutants",
      "Jeux de mots assumés",
      "Première personne du pluriel"
    ],
    "dont": [
      "Langue de bois d'agence",
      "Listes de buzzwords",
      "Ton neutre"
    ]
  },
  "imagery": {
    "summary": "Projets en très grand, collages, grain de film, couleurs saturées.",
    "do": [
      "Images à fond perdu",
      "Recadrages audacieux",
      "Mélange photo et formes graphiques"
    ],
    "dont": [
      "Photos de bureau aseptisées",
      "Cadres arrondis sages"
    ]
  },
  "guidelines": {
    "summary": "Contraste maximal, grille visible, une seule couleur vive à la fois.",
    "do": [
      "Bordures noires de 2 px",
      "Ombres dures décalées",
      "Titres immenses"
    ],
    "dont": [
      "Dégradés",
      "Coins très arrondis",
      "Plus d'une couleur vive par écran"
    ]
  },
  "components": [
    "button",
    "input",
    "card",
    "badge",
    "alert",
    "table"
  ]
}
