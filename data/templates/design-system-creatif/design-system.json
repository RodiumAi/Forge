      "$type": "duration",
      "fast": {
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$extensions": {
          "forge": {
            "style": "snappy"
          }
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.3,
          0,
          0,
          1
        ]
      }
    },
    "icon": {
      "library": {
        "$value": "lucide",
        "$description": "Traits épais, angles francs, comme dessinés au feutre."
      },
      "style": {
        "$value": "outline",
        "$extensions": {
          "forge": {
            "guidance": {
              "summary": "Traits épais, angles francs, comme dessinés au feutre.",
              "do": [
                "Icônes grandes et noires",
                "Flèches pour guider le regard"
              ],
              "dont": [
                "Icônes fines et grises",
                "Emojis à la place des icônes"
              ]
            }
          }
        }
