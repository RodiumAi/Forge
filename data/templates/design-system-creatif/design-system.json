{
  "version": 1,
  "name": "Studio Ondé",
  "description": "Studio de design et motion à Dakar. Audacieux, joueur, sûr de lui.",
  "tokens": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#fff7ec",
        "$description": "Page and slide background",
        "$extensions": {
          "forge": {
            "role": "bg"
          }
        }
      },
      "surface": {
        "$value": "#ffffff",
        "$description": "Cards, panels and inputs",
        "$extensions": {
          "forge": {
            "role": "surface"
          }
        }
      },
      "fg": {
        "$value": "#141414",
        "$description": "Main text",
        "$extensions": {
          "forge": {
            "role": "fg",
            "contrast": [
              {
                "on": "bg",
                "ratio": 17.34,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 18.42,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "muted": {
        "$value": "#545454",
        "$description": "Secondary text",
        "$extensions": {
          "forge": {
            "role": "muted",
            "contrast": [
              {
                "on": "bg",
                "ratio": 7.13,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 7.57,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "accent": {
        "$value": "#d6246e",
        "$description": "Brand accent: buttons, links, highlights",
        "$extensions": {
          "forge": {
            "role": "accent",
            "contrast": [
              {
                "on": "bg",
                "ratio": 4.56,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "border": {
        "$value": "#141414",
        "$description": "Hairlines, dividers and input borders",
        "$extensions": {
          "forge": {
            "role": "border"
          }
        }
      },
      "accent-contrast": {
        "$value": "#ffffff",
        "$description": "Text and icons on the accent colour",
        "$extensions": {
          "forge": {
            "role": "accent-contrast",
            "contrast": [
              {
                "on": "accent",
                "ratio": 4.84,
                "level": "AA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "secondary": {
        "$value": "#2f5bea",
        "$description": "Secondary brand colour",
        "$extensions": {
          "forge": {
            "role": "secondary"
          }
        }
      },
      "success": {
        "$value": "#137a3f",
        "$description": "Positive status",
        "$extensions": {
          "forge": {
            "role": "success",
            "contrast": [
              {
                "on": "bg",
                "ratio": 5.09,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "warning": {
        "$value": "#9a5b00",
        "$description": "Warning status",
        "$extensions": {
          "forge": {
            "role": "warning",
            "contrast": [
              {
                "on": "bg",
                "ratio": 5.11,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "danger": {
        "$value": "#b3261e",
        "$description": "Errors and destructive actions",
        "$extensions": {
          "forge": {
            "role": "danger",
            "contrast": [
              {
                "on": "bg",
                "ratio": 6.15,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "info": {
        "$value": "#2f5bea",
        "$description": "Neutral information",
        "$extensions": {
          "forge": {
            "role": "info",
            "contrast": [
              {
                "on": "bg",
                "ratio": 5.19,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Syne",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Titles and headings"
      },
      "body": {
        "$value": [
          "DM Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Body text and interface"
      },
      "mono": {
        "$value": [
          "Space Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Code and figures"
      }
    },
    "weight": {
