{
  "id": "s1",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s1-backdrop",
      "type": "shape",
      "x": 1060,
      "y": 0,
      "w": 860,
      "h": 1080,
      "z": 0,
      "shape": "rect",
      "fill": "--surface"
    },
    {
      "id": "s1-image",
      "type": "image",
      "x": 1000,
      "y": 90,
      "w": 820,
      "h": 900,
      "z": 1,
      "src": "public/images/magazine.webp",
      "alt": "Magazine ouvert, tasse et rouge à lèvres sur une table",
      "fit": "cover",
      "radius": 40,
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "kaboompics",
        "url": "https://pixabay.com/photos/red-lipgloss-lip-gloss-lipstick-792139/"
      }
    },
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 300,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 780,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Kit média 2027"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 396,
      "w": 780,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Racines, le magazine des cultures afro"
        }
      ],
      "style": {
        "font": "display",
        "size": 84,
        "weight": 600,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": -1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 720,
      "w": 780,
      "h": 150,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Un trimestriel papier, un site et un podcast hebdomadaire pour 1,2 million de lecteurs et d'auditeurs."
        }
      ],
      "style": {
        "font": "body",
        "size": 32,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.4
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 930,
      "w": 780,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Paris · Bruxelles · Dakar · Abidjan"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    }
  ]
}
