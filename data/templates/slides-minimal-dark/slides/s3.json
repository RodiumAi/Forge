{
  "id": "s3",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s3-bar",
      "type": "shape",
      "x": 140,
      "y": 100,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s3-kicker",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 126,
      "w": 1200,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Le vrai prix"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s3-heading",
      "type": "text",
      "role": "heading",
      "x": 140,
      "y": 176,
      "w": 1640,
      "h": 140,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Ce qu'une fonctionnalité coûte vraiment"
        }
      ],
      "style": {
        "font": "display",
        "size": 64,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s3-body",
      "type": "text",
      "role": "body",
      "x": 140,
      "y": 360,
      "w": 1060,
      "h": 560,
      "z": 3,
      "content": [
        {
          "type": "bullet-list",
          "items": [
            {
              "text": "Du temps de conception, de développement et de test"
            },
            {
              "text": "Une ligne de plus dans chaque menu et chaque documentation"
            },
            {
              "text": "Du support, des bugs et de la maintenance, pour toujours"
            },
            {
              "text": "De l'attention retirée à ce qui compte"
            }
          ]
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.55
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s3-panel",
      "type": "shape",
      "x": 1300,
      "y": 360,
      "w": 480,
      "h": 560,
      "z": 1,
      "shape": "rect",
      "fill": "--surface",
      "stroke": "--border",
      "strokeWidth": 1,
      "radius": 2
    },
    {
      "id": "s3-icon",
      "type": "icon",
      "x": 1360,
      "y": 420,
      "w": 72,
      "h": 72,
      "z": 3,
      "icon": "minus",
      "color": "--accent",
      "strokeWidth": 1.75
    },
    {
      "id": "s3-callout",
      "type": "text",
      "role": "body",
      "x": 1360,
      "y": 530,
      "w": 360,
      "h": 340,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "En 2024, 80 % de l'usage de notre app reposait sur 12 % des écrans."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.45
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s3-footer",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 1000,
      "w": 1100,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Moins, mais mieux · Théo Garnier"
        }
      ],
      "style": {
        "font": "body",
        "size": 20,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    },
    {
      "id": "s3-page",
      "type": "text",
      "role": "caption",
      "x": 1660,
      "y": 1000,
      "w": 120,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "03"
        }
      ],
      "style": {
        "font": "body",
        "size": 20,
        "weight": 400,
        "color": "--muted",
        "align": "right",
        "lineHeight": 1.4
      }
    }
  ]
}
