          "type": "paragraph",
          "text": "Une forêt, une usine à oxygène"
        }
      ],
      "style": {
        "font": "display",
        "size": 60,
        "weight": 600,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      }
    },
    {
      "id": "s5-body",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 490,
      "w": 780,
      "h": 180,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Un hectare de forêt tempérée absorbe environ 5 tonnes de CO2 par an."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.5
      }
    },
    {
      "id": "s5-list",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 690,
      "w": 780,
      "h": 250,
      "z": 3,
      "content": [
        {
          "type": "bullet-list",
          "items": [
            {
              "text": "Le carbone est stocké dans le bois et les sols"
            },
            {
              "text": "Le phytoplancton produit près de la moitié de l'oxygène"
            },
            {
              "text": "La déforestation réduit ce puits de carbone"
            }
          ]
        }
      ],
      "style": {
        "font": "body",
        "size": 28,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.55
      }
    },
    {
      "id": "s5-page",
      "type": "text",
