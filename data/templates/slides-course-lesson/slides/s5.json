{
  "id": "s5",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s5-image",
      "type": "image",
      "x": 0,
      "y": 0,
      "w": 880,
      "h": 1080,
      "z": 1,
      "src": "public/images/forest.webp",
      "alt": "Rayons de soleil dans une forêt",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "ArtTower",
        "url": "https://pixabay.com/photos/forest-trees-sunlight-woods-56930/"
      }
    },
    {
      "id": "s5-bar",
      "type": "shape",
