{
  "id": "s2",
  "background": {
    "type": "image",
    "src": "public/images/circuit.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.82,
    "credit": {
      "source": "pixabay",
      "author": "blickpixel",
      "url": "https://pixabay.com/photos/circuit-board-computer-chip-564815/"
    }
  },
  "elements": [
    {
      "id": "s2-number",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 250,
      "w": 600,
      "h": 240,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "01"
        }
      ],
      "style": {
        "font": "display",
        "size": 200,
        "weight": 700,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s2-bar",
      "type": "shape",
      "x": 140,
      "y": 510,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s2-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 550,
      "w": 1500,
      "h": 200,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Le problème"
        }
      ],
      "style": {
        "font": "display",
        "size": 88,
        "weight": 700,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s2-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 770,
      "w": 1400,
      "h": 100,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Des scripts cron fragiles partout dans l'entreprise."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    }
  ]
}
