{
  "id": "s5",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s5-photo",
      "type": "group",
      "x": 110,
      "y": 110,
      "w": 760,
      "h": 880,
      "z": 1,
      "rotation": -3,
      "matchKey": "hero-image",
      "children": [
        {
          "id": "s5-paper",
          "type": "shape",
          "x": 0,
          "y": 0,
          "w": 760,
          "h": 880,
          "z": 0,
          "shape": "rect",
          "fill": "--surface",
          "stroke": "--border",
          "strokeWidth": 1,
          "radius": 4
        },
        {
          "id": "s5-image",
          "type": "image",
          "x": 30,
          "y": 30,
          "w": 700,
          "h": 720,
          "z": 1,
          "src": "public/images/street.webp",
          "alt": "Ruelle ensoleillée d'une vieille ville",
          "fit": "cover",
          "credit": {
            "source": "pixabay",
            "author": "MarciMarc105",
            "url": "https://pixabay.com/photos/palma-de-mallorca-alley-buildings-2900559/"
          }
        },
        {
          "id": "s5-caption",
          "type": "text",
          "role": "caption",
          "x": 30,
          "y": 780,
          "w": 700,
          "h": 60,
          "z": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Porto, jour 12"
            }
          ],
          "style": {
            "font": "mono",
            "size": 24,
            "weight": 400,
            "color": "--muted",
            "align": "center",
            "lineHeight": 1.4
          }
        }
      ]
    },
    {
      "id": "s5-bar",
      "type": "shape",
      "x": 1000,
      "y": 180,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s5-kicker",
      "type": "text",
      "role": "label",
      "x": 1000,
      "y": 206,
      "w": 780,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Coup de cœur"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s5-heading",
      "type": "text",
      "role": "heading",
      "x": 1000,
      "y": 256,
      "w": 780,
      "h": 210,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Porto, à pied et sans plan"
        }
      ],
      "style": {
        "font": "display",
        "size": 60,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s5-body",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 490,
      "w": 780,
      "h": 180,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Trois jours à arpenter les ruelles de la Ribeira, à monter et descendre des escaliers sans fin."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.5
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s5-list",
      "type": "text",
      "role": "body",
      "x": 1000,
      "y": 690,
      "w": 780,
      "h": 250,
      "z": 3,
      "content": [
        {
          "type": "bullet-list",
          "items": [
            {
              "text": "Le marché du Bolhão le matin"
            },
            {
              "text": "La traversée du pont Luís I au crépuscule"
            },
            {
              "text": "Une cave à porto familiale"
            }
          ]
        }
      ],
      "style": {
        "font": "body",
        "size": 28,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.55
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s5-page",
      "type": "text",
