      "x": 1660,
      "y": 1000,
      "w": 120,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "05"
        }
      ],
      "style": {
        "font": "body",
        "size": 20,
        "weight": 400,
        "color": "--muted",
        "align": "right",
        "lineHeight": 1.4
      }
    }
  ]
}
