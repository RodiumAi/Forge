{
  "id": "s1",
  "background": {
    "type": "image",
    "src": "public/images/lake.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.74,
    "credit": {
      "source": "pixabay",
      "author": "TeeFarm",
      "url": "https://pixabay.com/photos/lake-mountains-hut-mountain-lake-1681485/"
    }
  },
  "elements": [
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 450,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 486,
      "w": 1500,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Carnet de voyage · Été 2026"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 546,
      "w": 1500,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Des Alpes à l'Atlantique"
        }
      ],
      "style": {
        "font": "display",
        "size": 128,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": -1
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 870,
      "w": 1500,
      "h": 130,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Trois semaines, 2 860 kilomètres et un van nommé Gaston."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 120,
      "w": 1500,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Juillet 2026 · Annecy, Pyrénées, Porto, Algarve"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.4
      }
    }
  ]
}
