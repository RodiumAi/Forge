{
  "id": "s12",
  "background": {
    "type": "image",
    "src": "public/images/beach.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.78,
    "credit": {
      "source": "pixabay",
      "author": "Pok_Rie",
      "url": "https://pixabay.com/photos/sunset-beach-sand-rock-formations-1637376/"
    }
  },
  "elements": [
    {
      "id": "s12-bar",
      "type": "shape",
      "x": 140,
      "y": 260,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s12-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 300,
      "w": 1640,
      "h": 230,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Merci, et bonne route !"
        }
