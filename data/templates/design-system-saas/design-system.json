      "tight": {
        "$value": 1.15
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.55
      }
    },
    "type": {
      "$type": "typography",
      "display": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{text.5xl}",
          "fontWeight": "{weight.bold}",
          "lineHeight": "{leading.tight}",
          "letterSpacing": {
            "value": -1,
            "unit": "px"
          }
        }
      },
      "h1": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{text.4xl}",
          "fontWeight": "{weight.bold}",
          "lineHeight": "{leading.tight}",
          "letterSpacing": {
            "value": -0.5,
            "unit": "px"
          }
        }
      },
      "h2": {
