        }
      },
      "sm": {
        "$value": {
          "value": 13,
          "unit": "px"
        }
      },
      "base": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$extensions": {
          "forge": {
            "base": 16,
            "ratio": 1.2
          }
        }
      },
      "lg": {
        "$value": {
          "value": 19,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 23,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "3xl": {
        "$value": {
          "value": 33,
