          "fontFamily": "{font.mono}",
          "fontSize": "{text.sm}",
          "fontWeight": "{weight.regular}",
          "lineHeight": "{leading.normal}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        }
      }
