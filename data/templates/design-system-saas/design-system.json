  "logo": {
    "src": "public/brand/logo.svg",
    "minSizePx": 24,
    "clearSpace": "La hauteur du symbole tout autour du logo",
    "usage": [
      "Sur fond blanc ou ardoise très clair",
      "Version blanche sur le bleu d'accent",
      "Avoid: Déformer ou incliner le logo",
      "Avoid: Ajouter une ombre ou un dégradé",
      "Avoid: Le poser sur une photo chargée"
    ]
  },
  "voice": {
    "summary": "Direct, concret, sans jargon. On parle de résultats.",
    "do": [
      "Phrases courtes à l'actif",
      "Verbes d'action sur les boutons",
      "Chiffres précis"
    ],
    "dont": [
      "Superlatifs creux",
      "Jargon technique non expliqué",
      "Points d'exclamation"
    ]
  },
  "imagery": {
    "summary": "Captures d'interface nettes et illustrations géométriques sobres.",
    "do": [
      "Captures réelles du produit",
      "Fonds clairs et beaucoup d'air"
    ],
    "dont": [
      "Photos de banque d'images génériques",
      "Mockups 3D surchargés"
    ]
  },
  "guidelines": {
    "summary": "La clarté avant l'effet : une action principale par écran.",
    "do": [
      "Un seul bouton principal visible",
      "Aligner sur la grille de 8 px",
      "Contraste AA pour tout texte"
    ],
    "dont": [
      "Plus de deux couleurs d'accent",
      "Texte gris clair sur fond blanc",
      "Animations de plus de 300 ms"
    ]
  },
  "components": [
    "button",
    "input",
    "card",
    "badge",
    "alert",
    "table"
  ]
}
