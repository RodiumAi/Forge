{
  "version": 1,
  "name": "Ardoise",
  "description": "Logiciel B2B de gestion de projets pour équipes produit. Clair, précis, rassurant.",
  "tokens": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#ffffff",
        "$description": "Page and slide background",
        "$extensions": {
          "forge": {
            "role": "bg"
          }
        }
      },
      "surface": {
        "$value": "#f8fafc",
        "$description": "Cards, panels and inputs",
        "$extensions": {
          "forge": {
            "role": "surface"
          }
        }
      },
      "fg": {
        "$value": "#0f172a",
        "$description": "Main text",
        "$extensions": {
          "forge": {
            "role": "fg",
            "contrast": [
              {
                "on": "bg",
                "ratio": 17.85,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 17.06,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "muted": {
        "$value": "#475569",
        "$description": "Secondary text",
        "$extensions": {
          "forge": {
            "role": "muted",
            "contrast": [
              {
                "on": "bg",
                "ratio": 7.58,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 7.24,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "accent": {
        "$value": "#2563eb",
        "$description": "Brand accent: buttons, links, highlights",
        "$extensions": {
          "forge": {
            "role": "accent",
            "contrast": [
              {
                "on": "bg",
                "ratio": 5.17,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "border": {
        "$value": "#e2e8f0",
        "$description": "Hairlines, dividers and input borders",
        "$extensions": {
          "forge": {
            "role": "border"
          }
        }
      },
      "accent-contrast": {
        "$value": "#ffffff",
        "$description": "Text and icons on the accent colour",
        "$extensions": {
          "forge": {
            "role": "accent-contrast",
            "contrast": [
              {
                "on": "accent",
                "ratio": 5.17,
                "level": "AA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "secondary": {
        "$value": "#0ea5e9",
        "$description": "Secondary brand colour",
        "$extensions": {
          "forge": {
            "role": "secondary"
          }
        }
      },
      "success": {
        "$value": "#15803d",
        "$description": "Positive status",
        "$extensions": {
          "forge": {
            "role": "success",
            "contrast": [
              {
                "on": "bg",
                "ratio": 5.02,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "warning": {
        "$value": "#b45309",
        "$description": "Warning status",
        "$extensions": {
          "forge": {
            "role": "warning",
            "contrast": [
              {
                "on": "bg",
                "ratio": 5.02,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "danger": {
        "$value": "#b91c1c",
        "$description": "Errors and destructive actions",
        "$extensions": {
          "forge": {
            "role": "danger",
            "contrast": [
              {
                "on": "bg",
                "ratio": 6.47,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "info": {
        "$value": "#1d4ed8",
        "$description": "Neutral information",
        "$extensions": {
          "forge": {
            "role": "info",
            "contrast": [
              {
                "on": "bg",
                "ratio": 6.7,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Titles and headings"
      },
      "body": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Body text and interface"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Code and figures"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
