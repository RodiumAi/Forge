      "$type": "duration",
      "fast": {
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$extensions": {
          "forge": {
            "style": "snappy"
          }
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.3,
          0,
          0,
          1
        ]
      }
    },
    "icon": {
      "library": {
        "$value": "lucide",
        "$description": "Icônes au trait fin, toujours accompagnées d'un libellé dans la navigation."
      },
      "style": {
        "$value": "outline",
        "$extensions": {
          "forge": {
            "guidance": {
              "summary": "Icônes au trait fin, toujours accompagnées d'un libellé dans la navigation.",
              "do": [
                "Une seule taille par zone",
                "Couleur du texte, accent seulement pour l'état actif"
              ],
              "dont": [
                "Mélanger icônes pleines et au trait",
                "Icônes décoratives sans fonction"
              ]
            }
          }
        }
      },
