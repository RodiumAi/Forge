          "fontFamily": "{font.body}",
          "fontSize": "{text.xs}",
          "fontWeight": "{weight.medium}",
          "lineHeight": "{leading.normal}",
          "letterSpacing": {
            "value": 0.2,
            "unit": "px"
          }
        }
      },
      "code": {
