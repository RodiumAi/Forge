        "$extensions": {
          "forge": {
            "role": "accent-contrast",
            "contrast": [
              {
                "on": "accent",
                "ratio": 8.74,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "secondary": {
        "$value": "#8c6b3f",
