  "logo": {
    "src": "public/brand/logo.svg",
    "darkSrc": "public/brand/logo-dark.svg",
    "iconSrc": "public/brand/icon.svg",
    "minSizePx": 48,
    "clearSpace": "La hauteur totale du logo de chaque côté",
    "usage": [
      "Or sur noir",
      "Noir sur papier ivoire pour l'impression",
      "Toujours centré, avec beaucoup d'espace",
      "Avoid: Or brillant ou effet métallique",
      "Avoid: Logo sur une photo de produit",
      "Avoid: Taille inférieure à 48 px"
    ]
  },
  "voice": {
    "summary": "Peu de mots, choisis. On évoque, on ne vend pas.",
    "do": [
      "Phrases courtes et posées",
      "Vocabulaire de l'artisanat",
      "Vouvoyer"
    ],
    "dont": [
      "Promotions et pourcentages",
      "Superlatifs",
      "Points d'exclamation"
    ]
  },
  "imagery": {
    "summary": "Natures mortes en clair-obscur, matières en très gros plan, beaucoup de noir.",
    "do": [
      "Une lumière latérale unique",
      "Le geste de l'artisan",
      "Grain du cuir visible"
    ],
    "dont": [
      "Fonds blancs de catalogue",
      "Mannequins souriants",
      "Plus de trois produits par image"
    ]
  },
  "guidelines": {
    "summary": "Le vide est un luxe : beaucoup d'espace, peu d'éléments, aucun bruit.",
    "do": [
      "Marges généreuses",
      "Titres en serif, texte en sans",
      "Or réservé aux détails"
    ],
    "dont": [
      "Coins arrondis",
      "Ombres portées",
      "Plus de deux tailles de texte par bloc"
    ]
  },
  "components": [
    "button",
    "input",
    "card",
    "badge",
    "alert",
    "table"
  ]
