{
  "version": 1,
  "name": "Maison Orée",
  "description": "Maison de maroquinerie artisanale. Raffinée, discrète, intemporelle.",
  "tokens": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#0c0a09",
        "$description": "Page and slide background",
        "$extensions": {
          "forge": {
            "role": "bg"
          }
        }
      },
      "surface": {
        "$value": "#171412",
        "$description": "Cards, panels and inputs",
        "$extensions": {
          "forge": {
            "role": "surface"
          }
        }
      },
      "fg": {
        "$value": "#f2ece4",
        "$description": "Main text",
        "$extensions": {
          "forge": {
            "role": "fg",
            "contrast": [
              {
                "on": "bg",
                "ratio": 16.83,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 15.62,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "muted": {
        "$value": "#a8a097",
        "$description": "Secondary text",
        "$extensions": {
          "forge": {
            "role": "muted",
            "contrast": [
              {
                "on": "bg",
                "ratio": 7.66,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 7.11,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "accent": {
        "$value": "#c8a96a",
        "$description": "Brand accent: buttons, links, highlights",
        "$extensions": {
          "forge": {
            "role": "accent",
            "contrast": [
              {
                "on": "bg",
                "ratio": 8.79,
                "level": "AAA",
                "required": 3
              }
            ]
          }
        }
      },
      "border": {
        "$value": "#2a2521",
        "$description": "Hairlines, dividers and input borders",
        "$extensions": {
          "forge": {
            "role": "border"
