{
  "id": "s2",
  "background": {
    "type": "image",
    "src": "public/images/rings.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.82,
    "credit": {
      "source": "pixabay",
      "author": "Afishera",
      "url": "https://pixabay.com/photos/bouquet-rings-ring-wedding-3512676/"
    }
  },
  "elements": [
    {
      "id": "s2-ptframe",
      "type": "shape",
      "x": 40,
      "y": 40,
      "w": 1840,
      "h": 1000,
      "z": 0,
      "shape": "rect",
      "fill": "#0000",
      "stroke": "--border",
      "strokeWidth": 2
    },
    {
      "id": "s2-ptframe2",
      "type": "shape",
      "x": 56,
      "y": 56,
      "w": 1808,
      "h": 968,
      "z": 0,
      "shape": "rect",
      "fill": "#0000",
      "stroke": "--accent",
      "strokeWidth": 1,
      "opacity": 0.6
    },
    {
      "id": "s2-number",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 250,
      "w": 1640,
      "h": 240,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "I"
        }
      ],
      "style": {
        "font": "display",
        "size": 200,
        "weight": 600,
        "color": "--accent",
        "align": "center",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s2-bar",
      "type": "shape",
      "x": 900,
      "y": 510,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s2-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 550,
      "w": 1640,
      "h": 200,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Le grand jour"
        }
      ],
      "style": {
        "font": "display",
        "size": 88,
        "weight": 600,
        "color": "--fg",
        "align": "center",
        "lineHeight": 1.1
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s2-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 770,
      "w": 1640,
      "h": 100,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Une cérémonie laïque, puis la fête jusqu'au bout de la nuit."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--muted",
        "align": "center",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    }
  ]
}
