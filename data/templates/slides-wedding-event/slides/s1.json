      "x": 140,
      "y": 930,
      "w": 1640,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Réponse souhaitée avant le 15 mars 2027"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "center",
        "lineHeight": 1.4
      }
