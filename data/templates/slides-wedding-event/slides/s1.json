      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 1640,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Ont la joie de vous convier à leur mariage"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "center",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 396,
      "w": 1640,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Clara et Mathis"
        }
      ],
      "style": {
        "font": "display",
        "size": 156,
        "weight": 600,
        "color": "--fg",
        "align": "center",
        "lineHeight": 1.05,
        "letterSpacing": -1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
