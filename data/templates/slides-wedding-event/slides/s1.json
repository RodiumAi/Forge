      "w": 1640,
      "h": 130,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Samedi 12 juin 2027, au Domaine des Tilleuls, près de Saint-Émilion."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "center",
        "lineHeight": 1.35
