      "w": 1840,
      "h": 1000,
      "z": 0,
      "shape": "rect",
      "fill": "#0000",
      "stroke": "--border",
      "strokeWidth": 2
    },
    {
      "id": "s1-ptframe2",
      "type": "shape",
      "x": 56,
      "y": 56,
      "w": 1808,
      "h": 968,
      "z": 0,
      "shape": "rect",
      "fill": "#0000",
      "stroke": "--accent",
      "strokeWidth": 1,
      "opacity": 0.6
