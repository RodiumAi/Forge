{
  "id": "s1",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s1-image",
      "type": "image",
      "x": 1080,
      "y": 200,
      "w": 680,
      "h": 680,
      "z": 1,
      "src": "public/images/desk.webp",
      "alt": "Bureau clair vu de dessus avec ordinateur et carnet",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "StockSnap",
        "url": "https://pixabay.com/photos/laptop-mac-computer-browser-2559707/"
      },
      "radius": 340
    },
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 300,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 820,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Product Designer · 8 ans d'expérience"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 396,
      "w": 820,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Inès Morel"
        }
      ],
      "style": {
        "font": "display",
        "size": 140,
        "weight": 800,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": -1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 720,
      "w": 820,
      "h": 130,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Je conçois des produits numériques simples pour des usages complexes : santé, banque, mobilité."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 930,
      "w": 820,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Lyon ou à distance · Disponible en février 2027"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    },
    {
      "id": "s1-ring",
      "type": "shape",
      "x": 1050,
      "y": 170,
      "w": 740,
      "h": 740,
      "z": 0,
      "shape": "ellipse",
      "fill": "#0000",
      "stroke": "--accent",
      "strokeWidth": 4
    },
    {
      "id": "s1-blob",
      "type": "shape",
      "x": 1500,
      "y": 700,
      "w": 300,
      "h": 300,
      "z": 0,
      "shape": "ellipse",
      "fill": "--accent-2",
      "opacity": 0.85
    }
  ]
}
