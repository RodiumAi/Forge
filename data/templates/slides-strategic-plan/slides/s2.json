{
  "id": "s2",
  "background": {
    "type": "image",
    "src": "public/images/compass.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.82,
    "credit": {
      "source": "pixabay",
      "author": "Ylanite",
      "url": "https://pixabay.com/photos/compass-travel-navigation-close-up-7592447/"
    }
  },
  "elements": [
    {
      "id": "s2-mark",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 120,
      "w": 300,
      "h": 240,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "«"
        }
      ],
      "style": {
        "font": "display",
        "size": 240,
        "weight": 700,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.0
      }
    },
    {
      "id": "s2-quote",
      "type": "text",
      "role": "quote",
      "x": 140,
      "y": 370,
      "w": 1500,
      "h": 380,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Un plan ne vaut que par les choix qu'il assume. Nous en faisons trois, et nous renonçons au reste. »"
        }
      ],
      "style": {
        "font": "display",
        "size": 58,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.3,
        "italic": true
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s2-bar",
      "type": "shape",
      "x": 140,
      "y": 790,
      "w": 80,
      "h": 8,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 4,
      "matchKey": "accent-bar"
    },
    {
      "id": "s2-author",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 820,
      "w": 1200,
      "h": 50,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Nadia Ferrer"
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 700,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.3
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s2-role",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 874,
      "w": 1200,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Directrice générale de Valtéo"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    },
    {
      "id": "s2-footer",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 1000,
      "w": 1100,
      "h": 40,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Valtéo · Plan stratégique Horizon 2030"
        }
