{
  "id": "s1",
  "background": {
    "type": "image",
    "src": "public/images/summit.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.6,
    "credit": {
      "source": "pixabay",
      "author": "kinkate",
      "url": "https://pixabay.com/photos/mountain-landscape-steps-stones-2031539/"
    }
  },
  "elements": [
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 300,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 1500,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Plan stratégique 2026-2030"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 396,
      "w": 1500,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Horizon 2030 : l'eau, notre cap"
        }
      ],
      "style": {
        "font": "display",
        "size": 108,
        "weight": 700,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": -1
      },
      "animation": {
        "type": "mask-reveal",
        "trigger": "on-enter",
        "direction": "up",
        "durationMs": 700
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 720,
      "w": 1500,
      "h": 130,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Les choix de Valtéo pour garantir une eau sûre et abordable à 1,2 million d'habitants."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
        "delayMs": 120,
        "durationMs": 500
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 930,
      "w": 1500,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Séminaire de direction · Annecy · 9 décembre 2026"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    }
  ]
}
