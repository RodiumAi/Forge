      "x": 140,
      "y": 930,
      "w": 820,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Concours restreint · Remise du 15 février 2027"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
