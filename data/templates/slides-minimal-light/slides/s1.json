      "y": 396,
      "w": 820,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Un siège qui laisse respirer"
        }
      ],
      "style": {
        "font": "display",
        "size": 104,
        "weight": 500,
        "color": "--fg",
