{
  "id": "s1",
  "background": {
    "type": "color",
    "token": "--bg"
  },
  "elements": [
    {
      "id": "s1-image",
      "type": "image",
      "x": 1300,
      "y": 0,
      "w": 620,
      "h": 1080,
      "z": 1,
      "src": "public/images/wall.webp",
      "alt": "Mur blanc et escalier sous une lumière rasante",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "aurikami",
        "url": "https://pixabay.com/photos/street-stairs-wall-architecture-7550171/"
      }
    },
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 300,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 820,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Note d'intention · Projet Verso"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
