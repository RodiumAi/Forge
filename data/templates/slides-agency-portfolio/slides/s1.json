{
  "id": "s1",
  "background": {
    "type": "image",
    "src": "public/images/studio.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.66,
    "credit": {
      "source": "pixabay",
      "author": "ClickerHappy",
      "url": "https://pixabay.com/photos/brushes-painter-work-shop-bowl-3129361/"
    }
  },
  "elements": [
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 300,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 1500,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Agence de design · Bordeaux"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 396,
      "w": 1500,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Studio Trame"
        }
      ],
      "style": {
        "font": "display",
        "size": 150,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": 0,
        "uppercase": true
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 720,
      "w": 1500,
      "h": 130,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Identités, campagnes et sites pour les marques qui ont quelque chose à dire."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 930,
      "w": 1500,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Portfolio 2026 · 14 personnes · 9 ans"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    }
  ]
}
