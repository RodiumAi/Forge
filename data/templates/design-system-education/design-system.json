    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.3,
          0,
          0,
          1
        ]
      }
    },
    "icon": {
      "library": {
        "$value": "lucide",
        "$description": "Icônes généreuses, l'accent souligne la progression."
      },
      "style": {
        "$value": "duotone",
        "$extensions": {
          "forge": {
            "guidance": {
              "summary": "Icônes généreuses, l'accent souligne la progression.",
              "do": [
                "Étoiles et badges pour les réussites",
                "Icônes de matière cohérentes"
              ],
              "dont": [
                "Icônes punitives (croix rouges en série)",
                "Pictogrammes trop détaillés"
              ]
            }
          }
        }
