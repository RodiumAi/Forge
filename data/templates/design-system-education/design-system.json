  "logo": {
    "src": "public/brand/logo.svg",
    "minSizePx": 28,
    "clearSpace": "La moitié de la hauteur du logo",
    "usage": [
      "Couleur sur fond clair",
      "Blanc sur l'orange pour les badges",
      "Avoid: Ajouter des yeux ou une mascotte au logo",
      "Avoid: Contour épais autour",
      "Avoid: Plus de deux couleurs"
    ]
  },
  "voice": {
    "summary": "Encourageant et concret. L'erreur est une étape.",
    "do": [
      "Féliciter l'effort",
      "Consignes en une phrase",
      "Tutoyer"
    ],
    "dont": [
      "Ironie",
      "Comparer les élèves entre eux",
      "Mots de plus de trois syllabes sans besoin"
    ]
  },
  "imagery": {
    "summary": "Illustrations colorées et rondes, élèves variés et souriants.",
    "do": [
      "Illustrations plates aux formes rondes",
      "Scènes de classe et de maison"
    ],
    "dont": [
      "Photos de manuels scolaires",
      "Clichés de génie en blouse"
    ]
  },
  "guidelines": {
    "summary": "Progression visible à chaque instant, jamais de cul-de-sac.",
    "do": [
      "Barre de progression sur chaque leçon",
      "Retour immédiat à chaque réponse"
    ],
    "dont": [
      "Pages de texte sans respiration",
      "Plus de trois choix par question"
    ]
  },
  "components": [
    "button",
    "input",
    "card",
    "badge",
    "alert",
    "table"
  ]
}
