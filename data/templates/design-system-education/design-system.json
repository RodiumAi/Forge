{
  "version": 1,
  "name": "Kalo",
  "description": "Plateforme de soutien scolaire pour collégiens. Chaleureuse, encourageante, ludique.",
  "tokens": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#fffaf3",
        "$description": "Page and slide background",
        "$extensions": {
          "forge": {
            "role": "bg"
          }
        }
      },
      "surface": {
        "$value": "#ffffff",
        "$description": "Cards, panels and inputs",
        "$extensions": {
          "forge": {
            "role": "surface"
          }
        }
      },
      "fg": {
        "$value": "#1f2a44",
        "$description": "Main text",
        "$extensions": {
          "forge": {
            "role": "fg",
            "contrast": [
              {
                "on": "bg",
                "ratio": 13.73,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 14.26,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "muted": {
        "$value": "#55607a",
        "$description": "Secondary text",
        "$extensions": {
          "forge": {
            "role": "muted",
            "contrast": [
              {
                "on": "bg",
                "ratio": 6.05,
                "level": "AA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 6.29,
                "level": "AA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "accent": {
        "$value": "#c2410c",
        "$description": "Brand accent: buttons, links, highlights",
        "$extensions": {
          "forge": {
            "role": "accent",
            "contrast": [
              {
                "on": "bg",
                "ratio": 4.99,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "border": {
        "$value": "#f0e4d4",
        "$description": "Hairlines, dividers and input borders",
        "$extensions": {
          "forge": {
            "role": "border"
          }
        }
      },
      "accent-contrast": {
        "$value": "#ffffff",
        "$description": "Text and icons on the accent colour",
        "$extensions": {
          "forge": {
            "role": "accent-contrast",
            "contrast": [
              {
                "on": "accent",
                "ratio": 5.18,
                "level": "AA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "secondary": {
        "$value": "#1d4ed8",
        "$description": "Secondary brand colour",
        "$extensions": {
          "forge": {
            "role": "secondary"
          }
        }
      },
      "success": {
        "$value": "#15803d",
        "$description": "Positive status",
        "$extensions": {
          "forge": {
            "role": "success",
            "contrast": [
              {
                "on": "bg",
                "ratio": 4.83,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "warning": {
        "$value": "#a16207",
        "$description": "Warning status",
        "$extensions": {
          "forge": {
            "role": "warning",
            "contrast": [
              {
                "on": "bg",
                "ratio": 4.74,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "danger": {
        "$value": "#b91c1c",
        "$description": "Errors and destructive actions",
        "$extensions": {
          "forge": {
            "role": "danger",
            "contrast": [
              {
                "on": "bg",
                "ratio": 6.23,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "info": {
        "$value": "#1d4ed8",
        "$description": "Neutral information",
        "$extensions": {
          "forge": {
            "role": "info",
            "contrast": [
              {
                "on": "bg",
                "ratio": 6.45,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Fredoka",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Titles and headings"
      },
      "body": {
        "$value": [
          "Nunito",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Body text and interface"
      },
      "mono": {
        "$value": [
          "Space Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Code and figures"
