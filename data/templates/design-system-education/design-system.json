      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$extensions": {
          "forge": {
            "style": "snappy"
          }
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
