  "logo": {
    "src": "public/brand/logo.svg",
    "darkSrc": "public/brand/logo-dark.svg",
    "iconSrc": "public/brand/icon.svg",
    "minSizePx": 28,
    "clearSpace": "La moitié de la hauteur du logo",
    "usage": [
      "Version claire sur le bleu nuit",
      "Symbole seul pour l'icône d'application",
      "Avoid: Changer la couleur émeraude",
      "Avoid: Placer le logo sur un fond rouge",
      "Avoid: Animer le logo"
    ]
  },
  "voice": {
    "summary": "Rassurant et transparent. Chaque frais est annoncé avant l'action.",
    "do": [
      "Montants exacts avec la devise",
      "Expliquer ce qui va se passer",
      "Tutoyer avec respect"
    ],
    "dont": [
      "Promesses de gains",
      "Petites lignes cachées",
      "Urgence artificielle"
    ]
  },
  "imagery": {
    "summary": "Portraits d'entrepreneurs en lumière naturelle, couleurs désaturées.",
    "do": [
      "Vraies personnes au travail",
      "Cadrages serrés et sereins"
    ],
    "dont": [
      "Billets et pièces en gros plan",
      "Graphiques boursiers décoratifs"
    ]
  },
  "guidelines": {
    "summary": "La confiance se lit dans la constance : mêmes composants, mêmes mots.",
    "do": [
      "Chiffres en police mono alignés à droite",
      "Confirmer chaque transfert",
      "Contraste AA partout"
    ],
    "dont": [
      "Vert pour autre chose qu'un succès",
      "Tableaux sans séparateurs",
      "Texte sous 14 px"
    ]
  },
  "components": [
    "button",
    "input",
    "card",
    "badge",
    "alert",
    "table"
  ]
}
