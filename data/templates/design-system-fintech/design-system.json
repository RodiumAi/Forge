{
  "version": 1,
  "name": "Nuvia",
  "description": "Néobanque mobile pour les indépendants d'Afrique de l'Ouest. Sûre, moderne, sereine.",
  "tokens": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#0b1220",
        "$description": "Page and slide background",
        "$extensions": {
          "forge": {
            "role": "bg"
          }
        }
      },
      "surface": {
        "$value": "#131c2e",
        "$description": "Cards, panels and inputs",
        "$extensions": {
          "forge": {
            "role": "surface"
          }
        }
      },
      "fg": {
        "$value": "#e8eef8",
        "$description": "Main text",
        "$extensions": {
          "forge": {
            "role": "fg",
            "contrast": [
              {
                "on": "bg",
                "ratio": 16.06,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 14.61,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "muted": {
        "$value": "#94a3b8",
        "$description": "Secondary text",
        "$extensions": {
          "forge": {
            "role": "muted",
            "contrast": [
              {
                "on": "bg",
                "ratio": 7.3,
                "level": "AAA",
                "required": 4.5
              },
              {
                "on": "surface",
                "ratio": 6.64,
                "level": "AA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "accent": {
        "$value": "#10b981",
        "$description": "Brand accent: buttons, links, highlights",
        "$extensions": {
          "forge": {
            "role": "accent",
            "contrast": [
              {
                "on": "bg",
                "ratio": 7.38,
                "level": "AAA",
                "required": 3
              }
            ]
          }
        }
      },
      "border": {
        "$value": "#22304a",
        "$description": "Hairlines, dividers and input borders",
        "$extensions": {
          "forge": {
            "role": "border"
          }
        }
      },
      "accent-contrast": {
        "$value": "#0b0b0f",
        "$description": "Text and icons on the accent colour",
        "$extensions": {
          "forge": {
            "role": "accent-contrast",
            "contrast": [
              {
                "on": "accent",
                "ratio": 7.74,
                "level": "AAA",
                "required": 4.5
              }
            ]
          }
        }
      },
      "secondary": {
        "$value": "#38bdf8",
        "$description": "Secondary brand colour",
        "$extensions": {
          "forge": {
            "role": "secondary"
          }
        }
      },
      "success": {
        "$value": "#34d399",
        "$description": "Positive status",
        "$extensions": {
          "forge": {
            "role": "success",
            "contrast": [
              {
                "on": "bg",
                "ratio": 9.74,
                "level": "AAA",
                "required": 3
              }
            ]
          }
        }
      },
      "warning": {
        "$value": "#fbbf24",
        "$description": "Warning status",
        "$extensions": {
          "forge": {
            "role": "warning",
            "contrast": [
              {
                "on": "bg",
                "ratio": 11.22,
                "level": "AAA",
                "required": 3
              }
            ]
          }
        }
      },
      "danger": {
        "$value": "#f87171",
        "$description": "Errors and destructive actions",
        "$extensions": {
          "forge": {
            "role": "danger",
            "contrast": [
              {
                "on": "bg",
                "ratio": 6.77,
                "level": "AA",
                "required": 3
              }
            ]
          }
        }
      },
      "info": {
        "$value": "#60a5fa",
        "$description": "Neutral information",
        "$extensions": {
          "forge": {
            "role": "info",
            "contrast": [
              {
                "on": "bg",
                "ratio": 7.36,
                "level": "AAA",
                "required": 3
              }
            ]
          }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Manrope",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
