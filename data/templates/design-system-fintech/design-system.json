    "icon": {
      "library": {
        "$value": "lucide",
        "$description": "Icônes nettes et lisibles, l'émeraude réservée aux actions positives."
      },
      "style": {
        "$value": "outline",
        "$extensions": {
          "forge": {
            "guidance": {
              "summary": "Icônes nettes et lisibles, l'émeraude réservée aux actions positives.",
              "do": [
                "Flèches pour les flux d'argent",
                "Cadenas pour la sécurité"
              ],
              "dont": [
                "Icônes de pièces ou de billets clichés",
                "Rouge hors des alertes"
              ]
            }
          }
        }
