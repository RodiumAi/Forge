{
  "id": "s1",
  "background": {
    "type": "image",
    "src": "public/images/volcano.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.74,
    "credit": {
      "source": "pixabay",
      "author": "Gylfi",
      "url": "https://pixabay.com/photos/volcano-lava-iceland-nature-7396466/"
    }
  },
  "elements": [
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 300,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 1500,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Exposé de SVT · 5e B"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 396,
      "w": 1500,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Les volcans"
        }
      ],
      "style": {
        "font": "display",
        "size": 160,
        "weight": 600,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": -1
      },
      "animation": {
        "type": "rise",
        "trigger": "on-enter",
        "durationMs": 500
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 720,
      "w": 1500,
      "h": 130,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Comment ils se forment, pourquoi ils entrent en éruption et comment on vit à côté."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.35
      },
      "animation": {
        "type": "rise",
        "trigger": "after-previous",
        "delayMs": 80,
        "durationMs": 450
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 930,
      "w": 1500,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Inès, Lucas et Maëlle · Mars 2027"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    }
  ]
}
