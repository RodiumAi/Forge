    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.78,
    "credit": {
      "source": "pixabay",
      "author": "Felix-Mittermeier",
      "url": "https://pixabay.com/photos/thunderstorm-lightning-storm-night-3441687/"
    }
  },
  "elements": [
