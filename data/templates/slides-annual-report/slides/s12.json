      "w": 640,
      "h": 52,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "terresdouest.example/rapport-2026"
        }
      ],
      "style": {
        "font": "body",
        "size": 32,
        "weight": 500,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.5
      },
      "animation": {
        "type": "appear",
        "trigger": "after-previous",
