{
  "id": "s1",
  "background": {
    "type": "image",
    "src": "public/images/road.webp",
    "fit": "cover",
    "overlay": "--bg",
    "overlayOpacity": 0.66,
    "credit": {
      "source": "pixabay",
      "author": "mariya_m",
      "url": "https://pixabay.com/photos/mallorca-winding-road-mountains-6957128/"
    }
  },
  "elements": [
    {
      "id": "s1-bar",
      "type": "shape",
      "x": 140,
      "y": 300,
      "w": 120,
      "h": 10,
      "z": 2,
      "shape": "rect",
      "fill": "--accent",
      "radius": 5,
      "matchKey": "accent-bar"
    },
    {
      "id": "s1-label",
      "type": "text",
      "role": "label",
      "x": 140,
      "y": 336,
      "w": 1500,
      "h": 48,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Roadmap produit 2027"
        }
      ],
      "style": {
        "font": "body",
        "size": 26,
        "weight": 600,
        "color": "--accent",
        "align": "left",
        "lineHeight": 1.4,
        "letterSpacing": 3,
        "uppercase": true
      }
    },
    {
      "id": "s1-title",
      "type": "text",
      "role": "title",
      "x": 140,
      "y": 396,
      "w": 1500,
      "h": 300,
      "z": 3,
      "matchKey": "slide-title",
      "content": [
        {
          "type": "paragraph",
          "text": "Atlas, la flotte sans friction"
        }
      ],
      "style": {
        "font": "display",
        "size": 100,
        "weight": 700,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.05,
        "letterSpacing": -1
      }
    },
    {
      "id": "s1-subtitle",
      "type": "text",
      "role": "subtitle",
      "x": 140,
      "y": 720,
      "w": 1500,
      "h": 130,
      "z": 3,
      "opacity": 0.86,
      "content": [
        {
          "type": "paragraph",
          "text": "Ce que nous allons livrer cette année pour les 1 900 entreprises qui gèrent leurs véhicules avec Atlas."
        }
      ],
      "style": {
        "font": "body",
        "size": 34,
        "weight": 400,
        "color": "--fg",
        "align": "left",
        "lineHeight": 1.35
      }
    },
    {
      "id": "s1-meta",
      "type": "text",
      "role": "caption",
      "x": 140,
      "y": 930,
      "w": 1500,
      "h": 44,
      "z": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Revue produit · 15 janvier 2027"
        }
      ],
      "style": {
        "font": "body",
        "size": 24,
        "weight": 500,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.4
      }
    }
  ]
}
