      "type": "image",
      "x": 80,
      "y": 80,
      "w": 800,
      "h": 920,
      "z": 1,
      "src": "public/images/notes.webp",
      "alt": "Mur couvert de notes adhésives colorées",
      "fit": "cover",
      "matchKey": "hero-image",
      "credit": {
        "source": "pixabay",
        "author": "Pexels",
        "url": "https://pixabay.com/photos/sticky-notes-note-notice-board-1284667/"
      },
      "radius": 24
    },
    {
      "id": "s5-bar",
      "type": "shape",
