      "content": [
        {
          "type": "paragraph",
          "text": "Chaque demande est notée selon sa portée, son impact et l'effort. Les 30 premières passent en atelier avec des clients."
        }
      ],
      "style": {
        "font": "body",
        "size": 30,
        "weight": 400,
        "color": "--muted",
        "align": "left",
        "lineHeight": 1.5
