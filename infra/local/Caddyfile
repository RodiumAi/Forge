{
	admin off
	auto_https off
}

:80 {
	log {
		output stdout
		format console
	}

	handle /_rodium/* {
		uri strip_prefix /_rodium
		reverse_proxy api:8000 {
			header_up X-Rodium-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto http
			header_up X-Forwarded-Host {http.request.host}
		}
	}

	@lvh host *.lvh.me
	handle @lvh {
		map {http.request.host} {site_slug} {
			~^([^.]+)\.lvh\.me(?::\d+)?$ ${1}
			default _
		}

		@site_root path /
		handle @site_root {
			rewrite * /forge-assets/{site_slug}/index.html
			reverse_proxy minio:9000 {
				header_up Host minio:9000
				@missing status 404
				handle_response @missing {
					header Content-Type "text/html; charset=utf-8"
					respond "Site not published" 404
				}
			}
		}

		handle /* {
			rewrite * /forge-assets/{site_slug}{uri}
			reverse_proxy minio:9000 {
				header_up Host minio:9000
				@missing status 404
				handle_response @missing {
					rewrite * /forge-assets/{site_slug}/index.html
					reverse_proxy minio:9000 {
						header_up Host minio:9000
						@still_missing status 404
						handle_response @still_missing {
							header Content-Type "text/html; charset=utf-8"
							respond "Site not published" 404
						}
					}
				}
			}
		}
	}

	handle {
		forward_auth api:8000 {
			uri /v1/authorize-host
			header_up X-Rodium-Forwarded-Host {http.request.host}
			copy_headers X-Site-Slug
		}

		@site_root path /
		handle @site_root {
			rewrite * /forge-assets/{http.request.header.X-Site-Slug}/index.html
			reverse_proxy minio:9000 {
				header_up Host minio:9000
				@missing status 404
				handle_response @missing {
					header Content-Type "text/html; charset=utf-8"
					respond "Site not published" 404
				}
			}
		}

		handle /* {
			rewrite * /forge-assets/{http.request.header.X-Site-Slug}{uri}
			reverse_proxy minio:9000 {
				header_up Host minio:9000
				@missing status 404
				handle_response @missing {
					rewrite * /forge-assets/{http.request.header.X-Site-Slug}/index.html
					reverse_proxy minio:9000 {
						header_up Host minio:9000
						@still_missing status 404
						handle_response @still_missing {
							header Content-Type "text/html; charset=utf-8"
							respond "Site not published" 404
						}
					}
				}
			}
		}
	}
}
