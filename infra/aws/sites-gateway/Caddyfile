# Production Sites Gateway: serves published Forge sites from S3.
#
# Host routing:
#   1) {slug}.forge.rodiumai.io  -> slug from Host suffix (map)
#   2) custom domains            -> forward_auth /v1/authorize-host -> X-Site-Slug
#
# Env (ECS task):
#   SITES_HOST_SUFFIX=forge.rodiumai.io
#   S3_ASSETS_BUCKET=forge-assets-prod
#   S3_REGION=eu-west-1
#   FORGE_API_UPSTREAM=api-forge.rodiumai.io

{
	admin off
	auto_https off
}

# One published site, served from the assets bucket.
#   {args[0]} bucket path of the site (e.g. /forge-assets/my-slug)
#   {args[1]} bucket upstream          {args[2]} Host header for it
#
# /            -> index.html
# /a/b.ext     -> the file, or a plain 404 (a missing script never gets HTML)
# /page        -> page/index.html (pre-rendered route), else 404.html served
#                 with status 404, else index.html (sites published before
#                 pre-rendering: client-side routing). 403 counts as missing:
#                 S3 answers 403 for absent keys when listing is not allowed.
(published_site) {
	encode zstd gzip

	@root path /
	handle @root {
		rewrite * {args[0]}/index.html
		reverse_proxy {args[1]} {
			header_up Host {args[2]}
			@missing status 403 404
			handle_response @missing {
				header Content-Type "text/html; charset=utf-8"
				respond "Site not published" 404
			}
		}
	}

	# SVG renders as an image (<img src="/logo.svg">) but never runs scripts
	# when opened directly: sandboxed, no script source.
	@svg path_regexp svg (?i)\.svg$
	handle @svg {
		rewrite * {args[0]}{uri}
		reverse_proxy {args[1]} {
			header_up Host {args[2]}
			header_down Content-Type "image/svg+xml"
			header_down Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; sandbox"
			header_down X-Content-Type-Options "nosniff"
			@missing status 403 404
			handle_response @missing {
				respond "Not found" 404
			}
		}
	}

	# Files are known extensions; any other path is a page route, even with a
	# dot in it (/blog/v1.2, /u/jane.doe). Mirrors services/prerender.py.
	@file path_regexp file (?i)\.(js|mjs|css|map|json|html?|txt|xml|webmanifest|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|mp3|wav|ogg|pdf|zip)$
	handle @file {
		rewrite * {args[0]}{uri}
		reverse_proxy {args[1]} {
			header_up Host {args[2]}
			@missing status 403 404
			handle_response @missing {
				respond "Not found" 404
			}
		}
	}

	handle {
		@page path_regexp page ^(.*?)/?$
		rewrite @page {args[0]}{re.page.1}/index.html
		reverse_proxy {args[1]} {
			header_up Host {args[2]}
			@missing status 403 404
			handle_response @missing {
				rewrite * {args[0]}/404.html
				reverse_proxy {args[1]} {
					header_up Host {args[2]}
					@found status 200
					handle_response @found {
						copy_response_headers
						copy_response 404
					}
					@no_404_page status 403 404
					handle_response @no_404_page {
						rewrite * {args[0]}/index.html
						reverse_proxy {args[1]} {
							header_up Host {args[2]}
							@still_missing status 403 404
							handle_response @still_missing {
								header Content-Type "text/html; charset=utf-8"
								respond "Site not published" 404
							}
						}
					}
				}
			}
		}
	}
}

(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; connect-src * data: blob:; font-src 'self' data: blob: https: http:; form-action 'self' https: http:; frame-src 'self' data: blob: https: http:; img-src 'self' data: blob: https: http:; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https: http:; style-src 'self' 'unsafe-inline' data: blob: https: http:; worker-src 'self' blob:; frame-ancestors 'self'"
	}
}

:80 {
	log {
		output stdout
		format console
	}

	import site_headers

	handle /health {
		respond "ok" 200
	}

	@forge_subdomain host *.{$SITES_HOST_SUFFIX}
	handle @forge_subdomain {
		map {http.request.host} {site_slug} {
			~^([^.]+)\.{$SITES_HOST_SUFFIX}$ ${1}
			default _
		}
		import published_site /{site_slug} https://{$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com {$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com
	}

	# Custom domains (www.client.com, blog.client.com, ...)
	handle {
		forward_auth https://{$FORGE_API_UPSTREAM} {
			uri /v1/authorize-host
			header_up Host {$FORGE_API_UPSTREAM}
			header_up X-Rodium-Forwarded-Host {http.request.host}
			copy_headers X-Site-Slug
		}
		import published_site /{http.request.header.X-Site-Slug} https://{$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com {$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com
	}
}
