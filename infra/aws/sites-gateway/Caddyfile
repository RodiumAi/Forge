# Production Sites Gateway — mirrors infra/local/Caddyfile for AWS S3.
# Host: {slug}.forge.rodiumai.io  →  s3://{bucket}/{slug}/…
#
# Env (ECS task):
#   SITES_HOST_SUFFIX=forge.rodiumai.io
#   S3_ASSETS_BUCKET=forge-assets-prod
#   S3_REGION=eu-west-1
#   FORGE_API_UPSTREAM=api-forge.rodiumai.io

{
	admin off
	auto_https off
}

:80 {
	log {
		output stdout
		format console
	}

	handle /health {
		respond "ok" 200
	}

	map {http.request.host} {site_slug} {
		~^([^.]+)\.{$SITES_HOST_SUFFIX}$ ${1}
		default _
	}

	handle /_rodium/* {
		uri strip_prefix /_rodium
		reverse_proxy https://{$FORGE_API_UPSTREAM} {
			header_up Host {$FORGE_API_UPSTREAM}
			header_up X-Rodium-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {http.request.host}
		}
	}

	@site_root path /
	handle @site_root {
		rewrite * /{site_slug}/index.html
		reverse_proxy https://{$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com {
			header_up Host {$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com
			@missing status 404
			handle_response @missing {
				header Content-Type "text/html; charset=utf-8"
				respond `<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Site not published — Forge</title>
<style>
:root{color-scheme:dark}body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:ui-sans-serif,system-ui,sans-serif;background:#0a0a0c;color:#f5f5f5}
main{max-width:34rem;padding:2rem;text-align:center}h1{margin:0 0 .6rem;font-size:1.6rem;letter-spacing:-.02em}
p{margin:0 0 .85rem;color:#a3a3a3;line-height:1.5}code{color:#f2620a}.hint{font-size:.9rem}
</style></head><body><main>
<h1>Site not published yet</h1>
<p>Nothing is live at <code>{http.request.host}</code>.</p>
<p class="hint">Open the project in Forge and click <strong>Publish</strong>, then refresh this page.</p>
</main></body></html>` 404
			}
		}
	}

	handle /* {
		rewrite * /{site_slug}{uri}
		reverse_proxy https://{$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com {
			header_up Host {$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com
			@missing status 404
			handle_response @missing {
				rewrite * /{site_slug}/index.html
				reverse_proxy https://{$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com {
					header_up Host {$S3_ASSETS_BUCKET}.s3.{$S3_REGION}.amazonaws.com
					@still_missing status 404
					handle_response @still_missing {
						header Content-Type "text/html; charset=utf-8"
						respond `<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Site not published — Forge</title>
<style>
:root{color-scheme:dark}body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:ui-sans-serif,system-ui,sans-serif;background:#0a0a0c;color:#f5f5f5}
main{max-width:34rem;padding:2rem;text-align:center}h1{margin:0 0 .6rem;font-size:1.6rem;letter-spacing:-.02em}
p{margin:0 0 .85rem;color:#a3a3a3;line-height:1.5}code{color:#f2620a}.hint{font-size:.9rem}
</style></head><body><main>
<h1>Site not published yet</h1>
<p>Nothing is live at <code>{http.request.host}</code>.</p>
<p class="hint">Open the project in Forge and click <strong>Publish</strong>, then refresh this page.</p>
</main></body></html>` 404
					}
				}
			}
		}
	}
}
