# Copy to infra/aws/ecs/.env.ecs (gitignored) to override bootstrap defaults.
# If omitted, DATABASE_URL is built from monorepo rodiumai_nestjs/.env.aurora.

# DATABASE_URL=postgresql+psycopg://USER:PASS@rodiumai-db-prod.cluster-….amazonaws.com:5432/rodium_forge?sslmode=require
# SECRET_KEY=long-random-string
# REDIS_URL=rediss://rodiumai-cache-001….amazonaws.com:6379/1

# OIDC (register client in RodiumAI Nest before prod login)
# RODIUM_OIDC_CLIENT_ID=
# RODIUM_OIDC_CLIENT_SECRET=

# Object store keys (if not using task role for S3)
# OBJECT_STORE_ACCESS_KEY=
# OBJECT_STORE_SECRET_KEY=
