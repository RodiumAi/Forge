# AWS Amplify console → App settings → Environment variables (branch: main)
# Do not commit real values.

# Required for monorepo — Amplify reads package.json under apps/web
AMPLIFY_MONOREPO_APP_ROOT=apps/web

NEXT_PUBLIC_API_URL=https://api-forge.rodiumai.io
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=https://forge-uploads-prod.s3.eu-west-1.amazonaws.com
NEXT_PUBLIC_RODIUM_USER_APP_URL=https://rodiumai.io

# Optional — only if your auth layer needs public OIDC hints in the browser
# NEXT_PUBLIC_RODIUM_OIDC_ISSUER=https://auth.rodiumai.io

# Build / runtime (Amplify)
# DOCKER_BUILD must stay unset (or 0) — see apps/web/next.config.ts
FORGE_FONT_MODE=fallback
NODE_ENV=production
