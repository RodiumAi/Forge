# Copy to /opt/forge/infra/aws/ec2/.env on the EC2 instance (never commit the real file).
# Image URI is injected by deploy.sh from ECR.

FORGE_API_IMAGE=330990434320.dkr.ecr.eu-west-1.amazonaws.com/forge/api:latest
FORGE_API_BIND=127.0.0.1:8000
FORGE_ENV_FILE=.env
FORGE_HOST_ROOT=/opt/forge

ENVIRONMENT=production
SECRET_KEY=replace-with-long-random-string
ENCRYPTION_KEY=

# RDS — même cluster Aurora que rodium_platform / rodium_gateway
# Writer: rodiumai-db-prod.cluster-xxxx.eu-west-1.rds.amazonaws.com
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@rodiumai-db-prod.cluster-xxxx.eu-west-1.rds.amazonaws.com:5432/rodium_forge?sslmode=require

# ElastiCache / Valkey
REDIS_URL=rediss://forge-valkey.xxxxx.cache.amazonaws.com:6379/0

# S3 (replaces local MinIO)
OBJECT_STORE_ENDPOINT=https://s3.eu-west-1.amazonaws.com
OBJECT_STORE_PUBLIC_ENDPOINT=https://forge-uploads.s3.eu-west-1.amazonaws.com
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_ADDRESSING=virtual
BUCKET_UPLOADS=forge-uploads-prod
BUCKET_SITE_ASSETS=forge-assets-prod
BUCKET_RUNTIME=forge-runtime-prod

API_BASE_URL=https://api.forge.example.com
PROJECTS_ROOT=/data/projects
TEMPLATES_ROOT=/app/data/templates

# Amplify frontend origin(s) — comma-separated
CORS_ORIGINS=https://app.forge.example.com
RUNNER_PARENT_ORIGINS=https://app.forge.example.com

SITES_BASE_DOMAIN=sites.forge.example.com

RODIUM_BASE_URL=https://api.rodiumai.io/v1
RODIUM_OIDC_ISSUER=https://auth.rodiumai.io
RODIUM_OIDC_INTERNAL_ISSUER=https://auth.rodiumai.io
RODIUM_OIDC_CLIENT_ID=
RODIUM_OIDC_CLIENT_SECRET=
RODIUM_OIDC_REDIRECT_URI=https://app.forge.example.com/auth/callback

SSE_HEARTBEAT_SECONDS=15
ALB_IDLE_TIMEOUT_SECONDS=600
