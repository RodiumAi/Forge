SSE_HEARTBEAT_SECONDS=15
ALB_IDLE_TIMEOUT_SECONDS=600

GOOGLE_APPLICATION_CREDENTIALS=

MANAGED_STORAGE_BYTES_LIMIT=524288000

# Custom domains — leave ALB/TG empty locally (degraded verify mode)
# Prod: see infra/aws/sites-gateway/README.md
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_ALB_LISTENER_ARN=
CUSTOM_DOMAIN_GATEWAY_TG_ARN=

# Absolute path to the forkable template kits. Required to run pytest outside
# Docker (see CONTRIBUTING.md); docker-compose sets it for the container.
TEMPLATES_ROOT=../../data/templates

# ── Local accounts ─────────────────────────────────────────────────────────
# Public origin of the web app; used to build the links we email out.
WEB_APP_URL=http://localhost:3100
# Running the API on the host: `mailpit` does not resolve here, so print the
# links to this log instead. In Docker the compose file sets smtp + mailhog.
MAIL_TRANSPORT=console
MAIL_FROM=Forge By RodiumAi <noreply@example.com>

# Google / GitHub sign-in. All three empty → the endpoint answers 503 and the
# web app hides the buttons.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# RodiumAI account provisioning (hosted instance only). Empty → no-op.
RODIUM_PROVISION_URL=
RODIUM_PROVISION_TOKEN=
