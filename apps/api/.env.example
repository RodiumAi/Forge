RODIUM_OIDC_CLIENT_SECRET=
RODIUM_OIDC_REDIRECT_URI=http://localhost:3100/auth/callback
RODIUM_OIDC_SCOPES=openid profile email api_keys.read wallet.read
RODIUM_USER_APP_URL=http://localhost:3000

# PostHog (Cloud EU)
POSTHOG_ENABLED=false
# POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://eu.i.posthog.com

PROJECTS_ROOT=../../data/projects
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:8080
DEFAULT_MODEL=google/gemini-3.7-flash
LITE_MODEL=google/gemini-3.1-flash-lite
DEFAULT_IMAGE_MODEL=openai/gpt-image-2

PREVIEW_PUBLIC_HOST=lvh.me
PREVIEW_PUBLIC_PORT=3100
PREVIEW_PUBLIC_SCHEME=http
# vite | babel_runner (default: Babel/ESM â€” no Vite process)
# vite | esm (default: Babel transform publish â€” no vite build)
RUNNER_PARENT_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

OBJECT_STORE_PROVIDER=s3_compatible
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=rodiumdev
OBJECT_STORE_SECRET_KEY=rodiumdev123
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ADDRESSING=path
OBJECT_STORE_PREFIX=forge
BUCKET_SITE_ASSETS=forge-assets
BUCKET_UPLOADS=forge-uploads
BUCKET_RUNTIME=forge-runtime

KEY_PROVIDER=local
# openssl rand -base64 32 (exactement 32 octets dÃ©codÃ©s)
DEV_MASTER_KEY=SFyCEKXp4zIrhIu6Lh9Vbh/RiVLjWbNVsik7dw+uBvg=
KMS_KEY_ID=

SECRET_PROVIDER=env
SITE_JWT_MASTER_SECRET=ZGV2LWp3dC1tYXN0ZXItc2VjcmV0LWNoYW5nZS1tZQ==


QUEUE_PROVIDER=redis
