# Forge Web API â€” local development (Docker alternatives, pas de compte AWS)
ENVIRONMENT=local
LOG_LEVEL=debug
API_BASE_URL=http://localhost:8100
SITES_BASE_DOMAIN=lvh.me:8080

DATABASE_URL=postgresql+psycopg://forge:forge@127.0.0.1:5434/forge_web
SECRET_KEY=dev-secret-forge-web
ENCRYPTION_KEY=

RODIUM_BASE_URL=http://127.0.0.1:8001/v1

RODIUM_OIDC_ISSUER=http://127.0.0.1:3001
