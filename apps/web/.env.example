# On Windows + Docker, prefer 127.0.0.1 (localhost can resolve to IPv6 and fail)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100

# Absolute public origin of this app. Feeds metadataBase, robots.txt and
# sitemap.xml — leave as-is locally, set it for any real deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Domain published sites are served from. Locally this is Caddy via lvh.me,
# which resolves to 127.0.0.1 without touching your hosts file.
NEXT_PUBLIC_SITES_BASE_DOMAIN=lvh.me:8080

NEXT_PUBLIC_S3_PUBLIC_BASE_URL=https://cdn.rodiumai.io
NEXT_PUBLIC_RODIUM_USER_APP_URL=http://localhost:3000

# PostHog (Cloud EU)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_ENABLED=false

# ── Google / GitHub sign-in (optional) ─────────────────────────────────────
# All four must be present or the social buttons are not rendered — a clone
# should never show a sign-in option the API would answer with 503.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
