# Forge Web — copy to .env (docker compose)
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=rodium_forge
FORGE_WEB_POSTGRES_PORT=5434
FORGE_WEB_API_PORT=8100
FORGE_WEB_UI_PORT=3100
FORGE_WEB_ADMINER_PORT=8089
FORGE_WEB_CADDY_PORT=8080
FORGE_WEB_VALKEY_PORT=6380

MINIO_ROOT_USER=rodiumdev
MINIO_ROOT_PASSWORD=rodiumdev123

DATABASE_URL=postgresql+psycopg://forge:forge@127.0.0.1:5434/rodium_forge
SECRET_KEY=change-me-to-a-long-random-string-in-production
ENCRYPTION_KEY=
ENVIRONMENT=local
API_BASE_URL=http://localhost:8100
SITES_BASE_DOMAIN=lvh.me:8080

# Where the LLM calls go. The default below is the hosted RodiumAI gateway, so
# a paste-your-own-key setup works out of the box: create a free account on
# rodiumai.io, copy an `rd_sk_prod_...` key, and paste it in Forge's settings.
# Point this at your own gateway only if you run one.
RODIUM_BASE_URL=https://api.rodiumai.io/v1

# ── Sign-in ────────────────────────────────────────────────────────────────
# Local accounts (email/password) work with no configuration at all.
#
# "Continue with RodiumAI" is optional and needs the RodiumAI OIDC provider,
# a SEPARATE service not included in this repository. With CLIENT_ID empty,
# GET /auth/rodium/start returns 503 and the button is simply hidden.
# Browser authorize host (NestJS). For Docker API, set INTERNAL to host.docker.internal.
RODIUM_OIDC_ISSUER=http://127.0.0.1:3001
RODIUM_OIDC_INTERNAL_ISSUER=http://host.docker.internal:3001
RODIUM_OIDC_CLIENT_ID=
RODIUM_OIDC_CLIENT_SECRET=
RODIUM_OIDC_REDIRECT_URI=http://localhost:3100/auth/callback

# Guards the /internal/admin router. Leave empty to keep that router disabled
# (it returns 503) — which is what you want unless you are running admin tooling.
ADMIN_SECRET=

# Absolute public origin, used for metadataBase, robots.txt and sitemap.xml.
# Defaults to http://localhost:3100; set it for any real deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Origin the API uses to build the links it emails out (verify, reset).
WEB_APP_URL=http://localhost:3100

PROJECTS_ROOT=./data/projects
# Docker API mounts this at /data/templates
TEMPLATES_ROOT=./data/templates
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8100
DEFAULT_MODEL=google/gemini-3.7-flash
LITE_MODEL=google/gemini-3.1-flash-lite
DEFAULT_IMAGE_MODEL=openai/gpt-image-2
RUNNER_PARENT_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Optional: heavier model when ENABLE_PRO_ESCALATION=true
# ESCALATION_MODEL=google/gemini-3.7-flash
# ENABLE_PRO_ESCALATION=false

# Providers (overridden inside the api container for Docker hostnames)
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=rodiumdev
OBJECT_STORE_SECRET_KEY=rodiumdev123
OBJECT_STORE_ADDRESSING=path
BUCKET_UPLOADS=forge-uploads
BUCKET_SITE_ASSETS=forge-assets
BUCKET_RUNTIME=forge-runtime
KEY_PROVIDER=local
# LOCAL DEVELOPMENT ONLY. This key is public — it ships in this file, in a public
# repository. Never reuse it anywhere real. app/config.py refuses to boot in
# production unless KEY_PROVIDER=kms and this is unset.
DEV_MASTER_KEY=SFyCEKXp4zIrhIu6Lh9Vbh/RiVLjWbNVsik7dw+uBvg=
SECRET_PROVIDER=env
REDIS_URL=redis://127.0.0.1:6380/0
# SSE heartbeats + target ALB idle timeout (set ALB IdleTimeout=600 before first streamed run).
SSE_HEARTBEAT_SECONDS=15
ALB_IDLE_TIMEOUT_SECONDS=600


# Custom domains (Vercel-style CNAME flow) — leave ALB/TG empty locally (degraded mode)
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_ALB_LISTENER_ARN=
CUSTOM_DOMAIN_GATEWAY_TG_ARN=

# ── Transactional mail (email confirmation, password reset) ────────────────
# smtp     → the Mailpit container in this stack. The default: open
#            http://localhost:8026 and every message is there, links included.
# console  → print to the API log instead. Use it when you run the API on the
#            host rather than in Docker, where `mailhog` does not resolve.
# ses      → real delivery via AWS SES (needs AWS_* credentials).
# disabled → send nothing.
MAIL_TRANSPORT=smtp
MAIL_FROM=Forge <no-reply@example.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
# Host ports for the Mailpit UI and SMTP listener. Change them if something
# else on your machine already uses 1026/8026.
FORGE_WEB_MAILPIT_SMTP_PORT=1026
FORGE_WEB_MAILPIT_UI_PORT=8026

# ── Google / GitHub sign-in (optional) ─────────────────────────────────────
# Leave empty and the social buttons are not rendered at all. To enable them,
# create a Firebase project, turn on the Google and GitHub providers, and fill
# both the server credentials and the NEXT_PUBLIC_* pair below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key with literal 
 escapes, on one line.
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── RodiumAI account provisioning (hosted instance only) ───────────────────
# When set, creating a Forge account also creates a RodiumAI account and a
# generation key, so a new user can build immediately. Leave empty — the
# default — and Forge only ever creates local accounts.
RODIUM_PROVISION_URL=
RODIUM_PROVISION_TOKEN=
